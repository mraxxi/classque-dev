{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/worker", "src/shared"]
}
